# Loiterix quiet boot defaults
# Sets kernel native console loglevel defaults without forcing CMDLINE
# Bootloader can still override with explicit loglevel=X, debug, or ignore_loglevel

# Default console loglevel (3 = errors only, quiet boot)
CONFIG_CONSOLE_LOGLEVEL_DEFAULT=3

# Loglevel when bootloader passes "quiet"
CONFIG_CONSOLE_LOGLEVEL_QUIET=3
